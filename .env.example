# Base URL for the site in production or staging.
# Used for metadataBase, canonical URLs, Open Graph images, and sitemap generation.
# Do not use hardcoded production URLs without configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Verified executive contact email.
# If unset or empty, the contact section will truthfully display pending-verification status.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: Verified LinkedIn profile URL.
# If unset, no link will be displayed.
NEXT_PUBLIC_LINKEDIN_URL=
